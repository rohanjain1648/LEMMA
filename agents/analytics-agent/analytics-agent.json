{
  "name": "analytics-agent",
  "description": "Runs on a daily schedule. Queries ticket and response tables to surface trends: top categories, avg resolution time, auto-send rate, recurring issues. Writes a structured daily digest report to /reports.",
  "instruction": { "$file": "instruction.md" },
  "toolsets": ["POD"],
  "visibility": "POD",
  "permissions": { "grants": [
    { "resource_type": "datastore_table", "resource_name": "tickets",
      "permission_ids": ["datastore.table.read", "datastore.record.read"] },
    { "resource_type": "datastore_table", "resource_name": "responses",
      "permission_ids": ["datastore.table.read", "datastore.record.read"] },
    { "resource_type": "datastore_table", "resource_name": "customers",
      "permission_ids": ["datastore.table.read", "datastore.record.read"] },
    { "resource_type": "folder", "resource_name": "/reports",
      "permission_ids": ["folder.read", "folder.write"] }
  ] }
}
